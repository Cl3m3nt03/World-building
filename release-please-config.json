{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "builderz",
      "initial-version": "0.1.0",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "src-tauri/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='builderz')].version"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Fonctionnalités"
        },
        {
          "type": "fix",
          "section": "Corrections"
        },
        {
          "type": "perf",
          "section": "Performances"
        },
        {
          "type": "refactor",
          "section": "Refactorisation",
          "hidden": true
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Tests",
          "hidden": true
        },
        {
          "type": "build",
          "section": "Build",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "CI",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Maintenance",
          "hidden": true
        },
        {
          "type": "style",
          "section": "Style",
          "hidden": true
        }
      ]
    }
  }
}
