{
  "name": "builderz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare": "lefthook install",
    "lint": "pnpm lint:ts && pnpm lint:rust",
    "lint:ts": "biome check .",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "biome check --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "biome format . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:rust"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.13.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "lefthook": "2.1.14",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "5.0.2"
  }
}
