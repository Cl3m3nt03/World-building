{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "allow-app-info",
    "allow-default-worlds-dir",
    "allow-import-asset",
    "allow-import-asset-data",
    "allow-list-assets",
    "allow-rename-asset",
    "allow-delete-asset",
    "allow-asset-usages",
    "allow-get-settings",
    "allow-update-preferences",
    "allow-set-default-worlds-dir",
    "allow-remove-recent-world",
    "allow-missing-recent-worlds",
    "allow-relocate-recent-world",
    "allow-reveal-in-explorer",
    "allow-create-world",
    "allow-open-world",
    "allow-close-world",
    "allow-current-world",
    "allow-update-world",
    "allow-set-world-main-image"
  ]
}
