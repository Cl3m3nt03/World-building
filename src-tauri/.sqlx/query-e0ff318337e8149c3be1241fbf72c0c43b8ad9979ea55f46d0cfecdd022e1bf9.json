  "query": "SELECT l.source_id, c.title AS source_title, s.id AS \"story_id!\", s.title AS story_title,\n                  l.kind AS link_kind\n           FROM links l\n           JOIN chapters c ON c.id = l.source_id\n           JOIN stories s ON s.id = c.story_id\n           WHERE l.target_id = ?\n           ORDER BY s.sort_order, s.created_at, c.sort_order, l.kind",
